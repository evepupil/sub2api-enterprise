# 官网与模型调用同一个域名（如 codu.xyz）时的入口分流示例：
# - 模型调用（OpenAI / Anthropic / Gemini 各家接口）、后台接口 /api/v1、Claude Code 的遥测上报 → sub2api（:8080）
# - 其余所有路径（官网页面、控制台、官网自己的接口 /api/portal）→ 客户官网（:3000）
# 旧管理后台另绑一个域名，整站指向 sub2api 即可（照 deploy/Caddyfile）。
# 生产环境如果模型调用要先过 ACF 安全网关，把 @sub2api 那一段的上游换成网关地址。
# 说明见 deploy/PORTAL.md。

codu.xyz {
	@sub2api path /v1/* /v1beta/* /backend-api/* /antigravity/* /api/v1/* /api/event_logging/*

	handle @sub2api {
		reverse_proxy localhost:8080 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
			# 流式回复（SSE）边生成边转发，不攒包
			flush_interval -1
			transport http {
				keepalive 120s
				# 长对话、生图可能几分钟才出完
				response_header_timeout 10m
				read_timeout 15m
			}
		}
	}

	handle {
		reverse_proxy localhost:3000 {
			health_uri /api/portal/health
			health_interval 30s
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	# 压缩只列这几种类型：不能写 text/*，否则模型的流式回复（text/event-stream）会被压缩攒包、看起来卡住
	encode {
		zstd
		gzip 6
		minimum_length 256
		match {
			header Content-Type text/css*
			header Content-Type text/csv*
			header Content-Type text/html*
			header Content-Type text/javascript*
			header Content-Type text/plain*
			header Content-Type text/xml*
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type application/xml*
			header Content-Type image/svg+xml*
		}
	}

	log {
		output file /var/log/caddy/codu.log {
			roll_size 50mb
			roll_keep 10
		}
	}
}
