    "clsx": "2.1.1",
    "cobe": "2.0.1",
    "geist": "1.7.2",
    "lucide-react": "1.48.0",
    "motion": "13.4.4",
    "next": "16.3.6",
    "next-intl": "4.14.8",
    "next-themes": "0.4.6",
