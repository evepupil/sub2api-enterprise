# 服务端使用的固定 Sub2API 地址，只填写 origin，不含 /api/v1、查询或凭证。
# 未配置时，模型目录与状态页显示暂时不可用，不填充示例数据。
SUB2API_INTERNAL_URL=

# 浏览器访问门户的固定 origin，用于同源检查及付款回跳校验。
# 本地示例 http://127.0.0.1:3000；部署时填写实际 https 域名。
# 与 SUB2API_INTERNAL_URL 分开：后者可以是内网地址。
PORTAL_PUBLIC_URL=

# 开发时额外允许的完整 origin，多个用逗号分隔。
# PORTAL_PUBLIC_URL 会自动加入，127.0.0.1:3000 与 localhost:3000 同时保留。
# 例如 https://dev.example.com,https://your-tunnel.trycloudflare.com
# 只对 pnpm dev 生效，不改变生产环境的同源检查。修改后重启 dev。
PORTAL_DEV_ORIGINS=

# 内部 M0 组件预览，默认关闭。
PORTAL_UI_PREVIEW=0
