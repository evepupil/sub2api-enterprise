# Optional separate management host. Keep this server off the customer entrypoint.
server {
  listen 8080;
  server_name management.example.invalid;

  set $go_backend http://${GO_UPSTREAM};
  client_max_body_size 0;

  proxy_http_version 1.1;
  proxy_set_header Host $http_host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Forwarded-Host $http_host;
  proxy_set_header X-Forwarded-Port $server_port;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;
  proxy_set_header CF-Connecting-IP "";
  proxy_set_header True-Client-IP "";
  proxy_set_header Forwarded "";
  proxy_set_header X-Client-IP "";
  proxy_set_header X-Cluster-Client-IP "";
  proxy_set_header X-Original-Forwarded-For "";
  proxy_set_header X-Forwarded-Server "";
  proxy_cache off;
  proxy_no_cache 1;
  proxy_cache_bypass 1;

  location / {
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 1800s;
    proxy_send_timeout 1800s;
    proxy_pass $go_backend;
  }
}
