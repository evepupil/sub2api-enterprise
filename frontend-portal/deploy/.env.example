# Replace the image tag with a released, immutable portal image.
PORTAL_IMAGE=example.invalid/sub2api/frontend-portal:replace-me

# The portal service reaches the existing backend through this URL.
PORTAL_BACKEND_URL=http://host.docker.internal:18080
PORTAL_PUBLIC_URL=http://127.0.0.1:8088

# The edge proxy reaches the existing Go service at this internal host:port.
GO_UPSTREAM=host.docker.internal:18080

PORTAL_BIND_ADDRESS=127.0.0.1
PORTAL_HTTP_PORT=8088
